{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:extalia:protocol:worker-bundle-manifest:v1",
  "title": "Health-only worker bundle manifest v1",
  "description": "Generated from @extalia/protocol by tooling/generate-schemas.mjs; do not edit. The TypeScript validators remain the reference. Validator-only checks: sorted unique case-folded paths without file/directory collisions, exact role/reference correspondence, nonempty interpreter/script and aggregate byte limit; raw byte limits, duplicate JSON members, independently trusted digest and actual filesystem observations are separate receiver checks; no launch authority.",
  "$ref": "#/$defs/WorkerBundleManifest",
  "$defs": {
    "WorkerBundleManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "target",
        "runtime_version",
        "worker_version",
        "operations",
        "interpreter",
        "entry_script",
        "files"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "arch"
          ],
          "properties": {
            "os": {
              "type": "string",
              "enum": [
                "linux",
                "macos",
                "windows"
              ]
            },
            "arch": {
              "type": "string",
              "enum": [
                "x86_64",
                "aarch64"
              ]
            }
          }
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,127}$(?![\\s\\S])"
        },
        "worker_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,127}$(?![\\s\\S])"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "health"
          }
        },
        "interpreter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!(?:\\.|\\.\\.)(?:\\/|$))(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][0-9]|[lL][pP][tT][0-9])(?:\\.|\\/|$))(?![A-Za-z0-9_.-]*\\.(?:\\/|$))[A-Za-z0-9_.-]{1,64}(?:\\/(?!(?:\\.|\\.\\.)(?:\\/|$))(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][0-9]|[lL][pP][tT][0-9])(?:\\.|\\/|$))(?![A-Za-z0-9_.-]*\\.(?:\\/|$))[A-Za-z0-9_.-]{1,64}){0,15}$(?![\\s\\S])"
        },
        "entry_script": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!(?:\\.|\\.\\.)(?:\\/|$))(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][0-9]|[lL][pP][tT][0-9])(?:\\.|\\/|$))(?![A-Za-z0-9_.-]*\\.(?:\\/|$))[A-Za-z0-9_.-]{1,64}(?:\\/(?!(?:\\.|\\.\\.)(?:\\/|$))(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][0-9]|[lL][pP][tT][0-9])(?:\\.|\\/|$))(?![A-Za-z0-9_.-]*\\.(?:\\/|$))[A-Za-z0-9_.-]{1,64}){0,15}$(?![\\s\\S])"
        },
        "files": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!(?:\\.|\\.\\.)(?:\\/|$))(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][0-9]|[lL][pP][tT][0-9])(?:\\.|\\/|$))(?![A-Za-z0-9_.-]*\\.(?:\\/|$))[A-Za-z0-9_.-]{1,64}(?:\\/(?!(?:\\.|\\.\\.)(?:\\/|$))(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][0-9]|[lL][pP][tT][0-9])(?:\\.|\\/|$))(?![A-Za-z0-9_.-]*\\.(?:\\/|$))[A-Za-z0-9_.-]{1,64}){0,15}$(?![\\s\\S])"
              },
              "role": {
                "type": "string",
                "enum": [
                  "interpreter",
                  "entry_script",
                  "support"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 134217728
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            }
          }
        }
      }
    }
  }
}
