{
  "name": "extalia-vo",
  "description": "Open-source 3D virtual office for AI agents — local Bridge and web workspace to coordinate Codex, Claude Code, Gemini CLI, Antigravity, and Hermes.",
  "version": "0.4.362",
  "private": true,
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Extalia-VO/extalia-virtual-agent#readme",
  "bugs": {
    "url": "https://github.com/Extalia-VO/extalia-virtual-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Extalia-VO/extalia-virtual-agent.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "virtual-office",
    "3d-virtual-office",
    "ai-virtual-office",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "claude-code",
    "codex",
    "gemini-cli",
    "hermes-agent",
    "threejs",
    "workspace",
    "cli"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "bin": {
    "extalia": "./dist/extalia.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../tooling/check-no-models.mjs dist"
  },
  "dependencies": {
    "@extalia/core": "workspace:*",
    "@extalia/host": "workspace:*",
    "@extalia/platform": "workspace:*",
    "@extalia/protocol": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
