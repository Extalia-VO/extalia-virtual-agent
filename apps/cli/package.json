{
  "name": "extalia-vo",
  "description": "Extalia on your computer: the extalia command starts a local Bridge that serves the Extalia web UI and runs agents on this machine.",
  "version": "0.4.114",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Extalia-VO/extalia-virtual-agent.git",
    "directory": "apps/cli"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "bin": {
    "extalia": "./dist/extalia.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../tooling/check-no-models.mjs dist"
  },
  "dependencies": {
    "@extalia/core": "workspace:*",
    "@extalia/host": "workspace:*",
    "@extalia/platform": "workspace:*",
    "@extalia/protocol": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
